# Sentinel Payment Integrity — app environment (canonical template).
# Copy to .env and fill in real values. start.sh sources .env and validates it.
# Do NOT put DATABRICKS_CONFIG_FILE / DATABRICKS_CONFIG_PROFILE / DATABRICKS_TOKEN
# here — the launcher injects auth. Lakebase uses OAuth (no PGPASSWORD/PGUSER).

# ── Databricks workspace ──────────────────────────────────────────────────
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_WORKSPACE_ID=<workspace-id>
DATABRICKS_WAREHOUSE_ID=<warehouse-id>          # analytics + Delta→Lakebase sync
WAREHOUSE_ID=<warehouse-id>                      # same value; /platform deep-link tile

# ── Demo data (Unity Catalog) ─────────────────────────────────────────────
DEMO_CATALOG=<catalog>
DEMO_SCHEMA=<schema>

# ── Resource deep-links + agent wiring (from resources.json) ──────────────
DASHBOARD_ID=
PIPELINE_ID=
GENIE_SPACE_ID=
KA_ENDPOINT_NAME=
MAS_ENDPOINT_NAME=
AGENT_MLFLOW_EXPERIMENT_PATH=

# ── Lakebase (from scripts/lakebase_setup_db.sh) ──────────────────────────
# Resource PATHS (LAKEBASE_*) feed the AppKit plugin; PG* feed the pg.Pool.
LAKEBASE_ENDPOINT=projects/<project_id>/branches/production/endpoints/primary
LAKEBASE_BRANCH=projects/<project_id>/branches/production
LAKEBASE_DATABASE=projects/<project_id>/branches/production/databases/db-dbgen-<demo_short_name>
PGHOST=ep-xxx.database.xxx.cloud.databricks.com
PGDATABASE=dbgen_<demo_short_name>
PGPORT=5432
PGSSLMODE=require
