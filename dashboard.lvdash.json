{
  "datasets": [
    {
      "name": "ds_risk",
      "displayName": "Payment risk (metric view)",
      "queryLines": [
        "SELECT program, risk_level, ",
        "MEASURE(`improper_payment_exposure_usd`) AS improper_exposure_usd, ",
        "MEASURE(`flagged_payment_count`) AS flagged_count, ",
        "MEASURE(`projected_recovery_if_investigated_usd`) AS recovery_usd, ",
        "MEASURE(`payment_count`) AS queue_depth ",
        "FROM mv_payment_risk GROUP BY ALL"
      ]
    },
    {
      "name": "ds_queue",
      "displayName": "Open flagged queue",
      "queryLines": [
        "SELECT payment_id, program, risk_level, n_signals, ",
        "ARRAY_JOIN(signal_list, ', ') AS signal_list, payment_amount_usd, ",
        "improper_payment_exposure_usd, projected_recovery_if_investigated_usd, ",
        "recommended_disposition ",
        "FROM gold_queue_scored"
      ]
    },
    {
      "name": "ds_dispositions",
      "displayName": "Disposition mix",
      "queryLines": [
        "SELECT recommended_disposition, COUNT(*) AS case_count, ",
        "SUM(projected_recovery_if_investigated_usd) AS recovery_usd ",
        "FROM gold_disposition_recommendations GROUP BY recommended_disposition"
      ]
    },
    {
      "name": "ds_signals",
      "displayName": "Signal frequency (high-risk)",
      "queryLines": [
        "SELECT f.signal AS signal, COUNT(DISTINCT f.payment_id) AS payment_count ",
        "FROM raw_payment_fraud_flags f ",
        "JOIN gold_open_queue q ON f.payment_id = q.payment_id ",
        "WHERE q.risk_level = 'high' ",
        "GROUP BY f.signal ORDER BY payment_count DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "queue",
      "displayName": "Payment Queue",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "p1-title",
            "multilineTextboxSpec": {
              "lines": [
                "# Sentinel Payment Integrity — Pre-Disbursement Prevention\n",
                "**Della Okonkwo · Deputy Commissioner for Program Integrity.** A cross-agency fraud-match feed + eligibility-data refresh ~3 weeks ago surfaced a **spike of high-risk pre-disbursement payments** (red = highest improper-payment exposure). Each point of improper-payment rate prevented before funds move is **~$600M/yr**. This page tracks the queue, its exposure, and the prescribed disposition per payment — release, hold-for-verification, or refer-to-investigation."
              ]
            }
          },
          "position": {"x": 0, "y": 0, "width": 12, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-exposure",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_risk", "fields": [{"name": "sum(improper_exposure_usd)", "expression": "SUM(`improper_exposure_usd`)"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter", "frame": {"showTitle": true, "title": "Improper-payment exposure"}, "encodings": {"value": {"fieldName": "sum(improper_exposure_usd)", "displayName": "Exposure", "format": {"type": "number-currency", "currencyCode": "USD", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 1}}}}}
